#define BASE    0
#define NUMPAD  1
#define MOUSE   2
#define RESOLVE 3
#define AE      4
#define PS      5
#define LOGIC   6
#define SCROLL  7

#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>

&nice_view_spi { cs-gpios = <&pro_micro 1 GPIO_ACTIVE_HIGH>; };

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        td_layer_up: tap_dance_layer_up {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_LAYER_UP";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&to NUMPAD>, <&to BASE>;
        };

        td_layer_dn: tap_dance_layer_dn {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_LAYER_DN";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&to BASE>, <&to BASE>;
        };

        td_numpad: tap_dance_numpad {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_NUMPAD";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&tog NUMPAD>, <&tog NUMPAD>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";
            bindings = 
&kp TAB    &kp Q     &kp W         &kp E         &kp R      &kp T              &kp Y    &kp U      &kp I      &kp O    &kp P     &kp ESC
&kp LSHFT  &kp A     &kp S         &kp D         &kp F      &kp G              &kp H    &kp J      &kp K      &kp L    &kp SQT   &kp FSLH
&kp LGUI   &kp Z     &kp X         &kp C         &kp V      &kp B              &kp N    &kp M      &kp COMMA  &kp DOT  &kp SEMI  &kp RSHFT
&td_layer_up  &td_layer_dn  &kp SPACE  &kp BSPC  &kp LCTRL              &kp LALT  &kp ENTER                          &mo NUMPAD
            >;
        };

        numpad_layer {
            label = "NUMPAD";
            bindings = 
&kp EQUAL  &kp N7  &kp N8        &kp N9  &kp SLASH     &kp LSHFT          &none  &none  &none  &none  &kp ESC   &none
&kp MINUS  &kp N4  &kp N5        &kp N6  &kp N8        &kp LGUI           &none  &none  &kp UP  &kp DOWN  &kp RIGHT  &kp LSHFT
&kp N0     &kp N1  &kp N2        &kp N3  &kp DOT       &kp EQUAL          &kp LEFT  &kp DOWN  &kp RIGHT  &none  &none  &kp LGUI
&td_layer_up  &td_layer_dn  &kp ENTER  &kp LEFT  &kp RIGHT              &none  &none                  &tog NUMPAD
            >;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = 
&none  &none  &none  &none  &none  &none              &none      &none      &none  &none  &none  &none
&none  &none  &none  &none  &none  &none              &none      &none      &none  &none  &none  &none
&none  &none  &none  &none  &none  &none              &none      &none      &none  &none  &none  &none
&none  &none  &none  &none  &none              &mkp RCLK  &mkp LCLK              &none
            >;
        };

        resolve_layer {
            label = "RESOLVE";
            bindings = 
&none  &none  &none  &none  &none  &none              &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none              &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none              &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none              &none  &none              &none
            >;
        };

        ae_layer {
            label = "AE";
            bindings = 
&none  &none  &none  &none  &none  &none              &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none              &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none              &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none              &none  &none              &none
            >;
        };

        ps_layer {
            label = "PS";
            bindings = 
&none  &none  &none  &none  &none  &none              &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none              &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none              &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none              &none  &none              &none
            >;
        };

        logic_layer {
            label = "LOGIC";
            bindings = 
&none  &none  &none  &none  &none  &none              &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none              &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none              &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none              &none  &none              &none
            >;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = 
&trans  &trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans              &trans  &trans                                  &trans
            >;
        };
    };
};
